# TS 编译产物（不误伤 webui 的 src/lib 源码目录）
packages/*/lib
backend/lib
lib/
!packages/webui/src/lib/

# 构建产物（WebUI 编译输出），不提交。
# backend/webui/dist 保留 .gitkeep 占位：go:embed 需要目录存在才能编译，
# 全新 clone 在未跑 npm build 时也能 go build / go test。
packages/webui/dist
backend/webui/dist/*
!backend/webui/dist/.gitkeep

# 独立发行产物由 GitHub Releases 托管，不提交到仓库（仅根目录）
/dist/

external

node_modules
npm-debug.log
yarn-debug.log
yarn-error.log
tsconfig.tsbuildinfo

.eslintcache
.codex-go-cache/
**/.codex-go-cache/
.DS_Store
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln

# 本地 CodeGraph 索引与守护进程状态
.codegraph/

# ZCode 会话本地数据
.zcode/

# 运行时 / 本地产物，不应提交
backend/**/usage-records.jsonl
backend/**/*.sqlite3
backend/**/*.sqlite3-shm
backend/**/*.sqlite3-wal
backend/**/.db-key
backend/**/master.key
**/.master-key
**/elysia-api.sqlite3
**/elysia-api.sqlite3-shm
**/elysia-api.sqlite3-wal
config.json
package-lock.json
yarn.lock
