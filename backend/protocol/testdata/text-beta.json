{
  "schemaVersion": 2,
  "id": "text-beta",
  "name": "text-beta",
  "version": "1",
  "family": "text-beta",
  "wireVersion": "1",
  "capabilities": {
    "text": true
  },
  "directions": {
    "decode_request": {
      "transform": {
        "op": "object",
        "fields": {
          "model": {
            "op": "read",
            "from": "input",
            "path": "/engine"
          },
          "content": {
            "op": "map",
            "source": {
              "op": "read",
              "from": "input",
              "path": "/history"
            },
            "body": {
              "op": "object",
              "fields": {
                "kind": {
                  "op": "literal",
                  "value": "message"
                },
                "role": {
                  "op": "read",
                  "from": "item",
                  "path": "/speaker"
                },
                "children": {
                  "op": "map",
                  "source": {
                    "op": "read",
                    "from": "item",
                    "path": "/chunks"
                  },
                  "body": {
                    "op": "object",
                    "fields": {
                      "kind": {
                        "op": "literal",
                        "value": "text"
                      },
                      "payload": {
                        "op": "read",
                        "from": "item",
                        "path": "/value"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "encode_request": {
      "transform": {
        "op": "object",
        "fields": {
          "engine": {
            "op": "read",
            "from": "input",
            "path": "/model"
          },
          "history": {
            "op": "map",
            "source": {
              "op": "read",
              "from": "input",
              "path": "/content"
            },
            "body": {
              "op": "object",
              "fields": {
                "speaker": {
                  "op": "read",
                  "from": "item",
                  "path": "/role"
                },
                "chunks": {
                  "op": "map",
                  "source": {
                    "op": "read",
                    "from": "item",
                    "path": "/children"
                  },
                  "body": {
                    "op": "object",
                    "fields": {
                      "value": {
                        "op": "read",
                        "from": "item",
                        "path": "/payload"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "decode_response": {
      "transform": {
        "op": "object",
        "fields": {
          "id": {
            "op": "read",
            "from": "input",
            "path": "/resultId"
          },
          "status": {
            "op": "literal",
            "value": "completed"
          },
          "content": {
            "op": "map",
            "source": {
              "op": "read",
              "from": "input",
              "path": "/reply"
            },
            "body": {
              "op": "object",
              "fields": {
                "kind": {
                  "op": "literal",
                  "value": "message"
                },
                "role": {
                  "op": "read",
                  "from": "item",
                  "path": "/speaker"
                },
                "children": {
                  "op": "map",
                  "source": {
                    "op": "read",
                    "from": "item",
                    "path": "/chunks"
                  },
                  "body": {
                    "op": "object",
                    "fields": {
                      "kind": {
                        "op": "literal",
                        "value": "text"
                      },
                      "payload": {
                        "op": "read",
                        "from": "item",
                        "path": "/value"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "encode_response": {
      "transform": {
        "op": "object",
        "fields": {
          "resultId": {
            "op": "read",
            "from": "input",
            "path": "/id"
          },
          "reply": {
            "op": "map",
            "source": {
              "op": "read",
              "from": "input",
              "path": "/content"
            },
            "body": {
              "op": "object",
              "fields": {
                "speaker": {
                  "op": "read",
                  "from": "item",
                  "path": "/role"
                },
                "chunks": {
                  "op": "map",
                  "source": {
                    "op": "read",
                    "from": "item",
                    "path": "/children"
                  },
                  "body": {
                    "op": "object",
                    "fields": {
                      "value": {
                        "op": "read",
                        "from": "item",
                        "path": "/payload"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "operations": {
    "generate": {
      "kind": "generate",
      "method": "POST",
      "path": "/generate",
      "transport": "http_json",
      "request": "encode_request",
      "response": "decode_response",
      "auth": {
        "location": "none"
      }
    }
  },
  "native": {
    "preserve": true
  },
  "samples": [
    {
      "id": "request.decode",
      "direction": "decode_request",
      "capabilities": [
        "text"
      ],
      "input": {
        "engine": "m",
        "history": [
          {
            "speaker": "user",
            "chunks": [
              {
                "value": "hello"
              }
            ]
          }
        ]
      },
      "expected": {
        "schemaVersion": 1,
        "model": "m",
        "content": [
          {
            "kind": "message",
            "role": "user",
            "children": [
              {
                "kind": "text",
                "payload": "hello"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "request.encode",
      "direction": "encode_request",
      "capabilities": [
        "text"
      ],
      "input": {
        "schemaVersion": 1,
        "model": "m",
        "content": [
          {
            "kind": "message",
            "role": "user",
            "children": [
              {
                "kind": "text",
                "payload": "hello"
              }
            ]
          }
        ]
      },
      "expected": {
        "engine": "m",
        "history": [
          {
            "speaker": "user",
            "chunks": [
              {
                "value": "hello"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "response.decode",
      "direction": "decode_response",
      "capabilities": [
        "text"
      ],
      "input": {
        "resultId": "r",
        "reply": [
          {
            "speaker": "assistant",
            "chunks": [
              {
                "value": "answer"
              }
            ]
          }
        ]
      },
      "expected": {
        "schemaVersion": 1,
        "id": "r",
        "status": "completed",
        "content": [
          {
            "kind": "message",
            "role": "assistant",
            "children": [
              {
                "kind": "text",
                "payload": "answer"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "response.encode",
      "direction": "encode_response",
      "capabilities": [
        "text"
      ],
      "input": {
        "schemaVersion": 1,
        "id": "r",
        "status": "completed",
        "content": [
          {
            "kind": "message",
            "role": "assistant",
            "children": [
              {
                "kind": "text",
                "payload": "answer"
              }
            ]
          }
        ]
      },
      "expected": {
        "resultId": "r",
        "reply": [
          {
            "speaker": "assistant",
            "chunks": [
              {
                "value": "answer"
              }
            ]
          }
        ]
      }
    }
  ]
}
