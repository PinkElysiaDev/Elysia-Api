{
  "id": "openai-chat-completions",
  "version": "2.2.7",
  "family": "openai_chat",
  "wireVersion": "v2",
  "name": "OpenAI Chat migration draft (not enabled)",
  "operations": {
    "generate": {
      "kind": "generate",
      "method": "POST",
      "path": "/v1/chat/completions",
      "transport": "http_json",
      "request": "generation-request",
      "response": "provider-response",
      "auth": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      }
    },
    "models": {
      "kind": "models",
      "method": "GET",
      "path": "/models",
      "transport": "http_json",
      "auth": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "response": "model-page",
      "models": {}
    }
  },
  "documents": {
    "request": {
      "schema": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "allowUnknown": true
            }
          }
        },
        "allowUnknown": true
      }
    },
    "generation-request": {
      "schema": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "allowUnknown": true
            }
          }
        },
        "allowUnknown": true
      }
    },
    "provider-response": {
      "schema": {
        "type": "object",
        "required": [
          "choices"
        ],
        "properties": {
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "allowUnknown": true
            }
          }
        },
        "allowUnknown": true
      }
    },
    "client-response": {
      "schema": {
        "type": "object",
        "required": [
          "choices"
        ],
        "properties": {
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "allowUnknown": true
            }
          }
        },
        "allowUnknown": true
      }
    },
    "model-page": {
      "schema": {
        "type": "object",
        "allowUnknown": true
      }
    }
  }
}
