{
  "id": "gemini-api",
  "name": "Google Generate Content",
  "version": "5",
  "type": "llm",
  "metadata": {
    "preset": true,
    "presetVersion": 5,
    "description": "Gemini 线制的预置定义；v3：模型发现 idStripPrefix 剥离 name 的 models/ 集合前缀（入库 ID 与转发路径不再双前缀 404）; v4: preserve cache semantics and cache field mappings; v5: share native response and event adapters"
  },
  "request": {
    "method": "POST",
    "path": "/v1beta/models/{{maheshvara.model}}:generateContent",
    "pathStream": "/v1beta/models/{{maheshvara.model}}:streamGenerateContent?alt=sse",
    "shape": "gemini",
    "auth": {
      "mode": "header",
      "header": "x-goog-api-key"
    },
    "body": {
      "contents": {
        "field": "messages"
      },
      "systemInstruction": {
        "field": "gemini_system",
        "omitIfEmpty": true
      },
      "generationConfig": {
        "temperature": {
          "field": "temperature",
          "omitIfEmpty": true
        },
        "maxOutputTokens": {
          "field": "max_output_tokens",
          "omitIfEmpty": true
        },
        "topP": {
          "field": "top_p",
          "omitIfEmpty": true
        },
        "topK": {
          "field": "top_k",
          "omitIfEmpty": true
        },
        "stopSequences": {
          "field": "stop",
          "omitIfEmpty": true
        },
        "thinkingConfig": {
          "field": "thinking_config",
          "omitIfEmpty": true
        }
      },
      "tools": {
        "field": "tools",
        "omitIfEmpty": true
      },
      "toolConfig": {
        "field": "tool_config",
        "omitIfEmpty": true
      },
      "cachedContent": {
        "field": "cache_control",
        "omitIfEmpty": true
      }
    }
  },
  "response": {
    "adapter": "gemini",
    "stream": {
      "adapter": "gemini"
    }
  },
  "models": {
    "path": "/v1beta/models",
    "listPath": "models",
    "idPath": "name",
    "namePath": "displayName",
    "idStripPrefix": "models/"
  }
}
