{
  "id": "openai-chat-completions",
  "name": "Openai Chat Completions",
  "version": "6",
  "type": "llm",
  "metadata": {
    "preset": true,
    "presetVersion": 6,
    "description": "Chat Completions 线制的预置定义；复制后可定制端点/字段。v4：命名去厂商化；v3：path 相对化——base 填到 /v1 为止（对齐官方 base 约定），端点路径不含版本前缀; v5: preserve cache semantics and cache field mappings; v6: share native response and event adapters"
  },
  "request": {
    "method": "POST",
    "path": "/chat/completions",
    "shape": "openai-chat",
    "body": {
      "model": {
        "field": "model",
        "mode": "string"
      },
      "messages": {
        "field": "messages"
      },
      "stream": {
        "field": "stream"
      },
      "stream_options": {
        "include_usage": {
          "field": "stream_options.include_usage",
          "default": true,
          "when": {
            "path": "stream",
            "op": "isTrue"
          }
        }
      },
      "max_tokens": {
        "field": "max_output_tokens",
        "omitIfEmpty": true
      },
      "temperature": {
        "field": "temperature",
        "omitIfEmpty": true
      },
      "top_p": {
        "field": "top_p",
        "omitIfEmpty": true
      },
      "stop": {
        "field": "stop",
        "omitIfEmpty": true
      },
      "reasoning_effort": {
        "field": "reasoning_effort",
        "mode": "string",
        "omitIfEmpty": true
      },
      "tools": {
        "field": "tools",
        "omitIfEmpty": true
      },
      "tool_choice": {
        "field": "tool_choice",
        "omitIfEmpty": true
      },
      "parallel_tool_calls": {
        "field": "parallel_tool_calls",
        "omitIfEmpty": true
      },
      "response_format": {
        "field": "response_format",
        "omitIfEmpty": true
      },
      "user": {
        "field": "user",
        "mode": "string",
        "omitIfEmpty": true
      },
      "prompt_cache_key": {
        "field": "prompt_cache_key",
        "omitIfEmpty": true
      },
      "prompt_cache_retention": {
        "field": "prompt_cache_retention",
        "omitIfEmpty": true
      },
      "cache_control": {
        "field": "cache_control",
        "omitIfEmpty": true
      }
    }
  },
  "response": {
    "adapter": "openai-chat",
    "stream": {
      "adapter": "openai-chat"
    }
  },
  "models": {
    "path": "/models",
    "listPath": "data"
  }
}
