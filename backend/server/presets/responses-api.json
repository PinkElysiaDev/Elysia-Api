{
  "id": "responses-api",
  "name": "Responses API（预置）",
  "version": "2",
  "type": "llm",
  "metadata": {
    "preset": true,
    "presetVersion": 2,
    "description": "OpenAI Responses 线制的预置定义；v2：include 联动、签名/拒答帧、参数完成帧、parallel_tool_calls"
  },
  "request": {
    "method": "POST",
    "path": "/v1/responses",
    "shape": "responses",
    "body": {
      "model": {
        "field": "model",
        "mode": "string"
      },
      "input": {
        "field": "input_items"
      },
      "instructions": {
        "field": "instructions",
        "mode": "string",
        "omitIfEmpty": true
      },
      "stream": {
        "field": "stream"
      },
      "max_output_tokens": {
        "field": "max_output_tokens",
        "omitIfEmpty": true
      },
      "temperature": {
        "field": "temperature",
        "omitIfEmpty": true
      },
      "top_p": {
        "field": "top_p",
        "omitIfEmpty": true
      },
      "tools": {
        "field": "tools",
        "omitIfEmpty": true
      },
      "tool_choice": {
        "field": "tool_choice",
        "omitIfEmpty": true
      },
      "parallel_tool_calls": {
        "field": "parallel_tool_calls",
        "omitIfEmpty": true
      },
      "reasoning": {
        "field": "reasoning",
        "omitIfEmpty": true
      },
      "include": {
        "field": "include",
        "omitIfEmpty": true
      },
      "user": {
        "field": "user",
        "mode": "string",
        "omitIfEmpty": true
      }
    }
  },
  "response": {
    "textPath": "output",
    "textFilter": {
      "path": "type",
      "op": "equals",
      "value": "message"
    },
    "reasoningPath": "output",
    "reasoningFilter": {
      "path": "type",
      "op": "equals",
      "value": "reasoning"
    },
    "toolCallsPath": "output",
    "usagePath": "usage",
    "stream": {
      "frames": [
        {
          "event": "response.failed",
          "payloadPath": "response",
          "response": {
            "errorPath": "error"
          }
        },
        {
          "event": "response.output_text.delta",
          "response": {
            "textPath": "delta"
          }
        },
        {
          "event": "response.refusal.delta",
          "response": {
            "refusalPath": "delta"
          }
        },
        {
          "event": "response.reasoning_text.delta",
          "response": {
            "reasoningPath": "delta"
          }
        },
        {
          "event": "response.reasoning_signature.delta",
          "response": {
            "signaturePath": "delta",
            "signatureProvider": "openai"
          }
        },
        {
          "event": "response.output_item.added",
          "match": {
            "path": "item.type",
            "op": "equals",
            "value": "function_call"
          },
          "tool": {
            "indexPath": "output_index",
            "idPath": "item.call_id",
            "namePath": "item.name"
          }
        },
        {
          "event": "response.function_call_arguments.delta",
          "tool": {
            "indexPath": "output_index",
            "argumentsPath": "delta"
          }
        },
        {
          "event": "response.function_call_arguments.done",
          "toolDone": true,
          "tool": {
            "indexPath": "output_index"
          }
        },
        {
          "event": "response.completed",
          "terminal": true,
          "payloadPath": "response",
          "response": {
            "usagePath": "usage"
          }
        }
      ]
    }
  },
  "models": {
    "path": "/v1/models",
    "listPath": "data"
  },
  "aliases": {
    "textKeys": [
      "text",
      "content",
      "summary"
    ]
  }
}
