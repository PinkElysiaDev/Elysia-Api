{
  "id": "responses-api",
  "name": "Responses API（预置）",
  "version": "6",
  "type": "llm",
  "metadata": {
    "preset": true,
    "presetVersion": 6,
    "description": "Responses 线制的预置定义；v4：命名去厂商化；v3：path 相对化——base 填到 /v1 为止（对齐官方 base 约定），端点路径不含版本前缀; v5: preserve cache semantics and cache field mappings; v6: share native response and event adapters"
  },
  "request": {
    "method": "POST",
    "path": "/responses",
    "shape": "responses",
    "body": {
      "model": {
        "field": "model",
        "mode": "string"
      },
      "input": {
        "field": "input_items"
      },
      "instructions": {
        "field": "instructions",
        "mode": "string",
        "omitIfEmpty": true
      },
      "stream": {
        "field": "stream"
      },
      "max_output_tokens": {
        "field": "max_output_tokens",
        "omitIfEmpty": true
      },
      "temperature": {
        "field": "temperature",
        "omitIfEmpty": true
      },
      "top_p": {
        "field": "top_p",
        "omitIfEmpty": true
      },
      "tools": {
        "field": "tools",
        "omitIfEmpty": true
      },
      "tool_choice": {
        "field": "tool_choice",
        "omitIfEmpty": true
      },
      "parallel_tool_calls": {
        "field": "parallel_tool_calls",
        "omitIfEmpty": true
      },
      "reasoning": {
        "field": "reasoning",
        "omitIfEmpty": true
      },
      "include": {
        "field": "include",
        "omitIfEmpty": true
      },
      "user": {
        "field": "user",
        "mode": "string",
        "omitIfEmpty": true
      },
      "prompt_cache_key": {
        "field": "prompt_cache_key",
        "omitIfEmpty": true
      },
      "prompt_cache_retention": {
        "field": "prompt_cache_retention",
        "omitIfEmpty": true
      }
    }
  },
  "response": {
    "adapter": "responses",
    "stream": {
      "adapter": "responses"
    }
  },
  "models": {
    "path": "/models",
    "listPath": "data"
  }
}
