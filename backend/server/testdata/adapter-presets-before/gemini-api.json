{
  "id": "gemini-api",
  "name": "Gemini API（预置）",
  "version": "4",
  "type": "llm",
  "metadata": {
    "preset": true,
    "presetVersion": 4,
    "description": "Gemini 线制的预置定义；v3：模型发现 idStripPrefix 剥离 name 的 models/ 集合前缀（入库 ID 与转发路径不再双前缀 404）; v4: preserve cache semantics and cache field mappings"
  },
  "aliases": {
    "toolCall": {
      "id": [
        "functionCall.name"
      ],
      "name": [
        "functionCall.name"
      ],
      "arguments": [
        "functionCall.args"
      ],
      "signature": [
        "thoughtSignature"
      ],
      "signatureProvider": [
        "thoughtSignatureProvider"
      ]
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1beta/models/{{maheshvara.model}}:generateContent",
    "pathStream": "/v1beta/models/{{maheshvara.model}}:streamGenerateContent?alt=sse",
    "shape": "gemini",
    "auth": {
      "mode": "header",
      "header": "x-goog-api-key"
    },
    "body": {
      "contents": {
        "field": "messages"
      },
      "systemInstruction": {
        "field": "gemini_system",
        "omitIfEmpty": true
      },
      "generationConfig": {
        "temperature": {
          "field": "temperature",
          "omitIfEmpty": true
        },
        "maxOutputTokens": {
          "field": "max_output_tokens",
          "omitIfEmpty": true
        },
        "topP": {
          "field": "top_p",
          "omitIfEmpty": true
        },
        "topK": {
          "field": "top_k",
          "omitIfEmpty": true
        },
        "stopSequences": {
          "field": "stop",
          "omitIfEmpty": true
        },
        "thinkingConfig": {
          "field": "thinking_config",
          "omitIfEmpty": true
        }
      },
      "tools": {
        "field": "tools",
        "omitIfEmpty": true
      },
      "toolConfig": {
        "field": "tool_config",
        "omitIfEmpty": true
      },
      "cachedContent": {
        "field": "cache_control",
        "omitIfEmpty": true
      }
    }
  },
  "response": {
    "textPath": "candidates[0].content.parts",
    "textFilter": [
      {
        "path": "thought",
        "op": "isFalse"
      },
      {
        "path": "functionCall",
        "op": "isNull"
      }
    ],
    "reasoningPath": "candidates[0].content.parts",
    "reasoningFilter": [
      {
        "path": "thought",
        "op": "isTrue"
      }
    ],
    "toolCallsPath": "candidates[0].content.parts",
    "usagePath": "usageMetadata",
    "finishReasonPath": "candidates[0].finishReason",
    "stream": {
      "mode": "delta",
      "frames": [
        {
          "match": {
            "path": "error",
            "op": "notNull"
          },
          "response": {
            "errorPath": "error"
          }
        },
        {
          "match": {
            "path": "candidates[0].content.parts[0].functionCall",
            "op": "notNull"
          },
          "response": {
            "toolCallsPath": "candidates[0].content.parts",
            "usagePath": "usageMetadata",
            "finishReasonPath": "candidates[0].finishReason"
          }
        },
        {
          "match": {
            "path": "candidates[0].finishReason",
            "op": "notNull"
          },
          "terminal": true,
          "response": {
            "textPath": "candidates[0].content.parts",
            "textFilter": [
              {
                "path": "thought",
                "op": "isFalse"
              },
              {
                "path": "functionCall",
                "op": "isNull"
              }
            ],
            "reasoningPath": "candidates[0].content.parts",
            "reasoningFilter": [
              {
                "path": "thought",
                "op": "isTrue"
              }
            ],
            "usagePath": "usageMetadata",
            "finishReasonPath": "candidates[0].finishReason"
          }
        },
        {
          "match": {
            "path": "candidates[0]",
            "op": "isNull"
          },
          "response": {
            "usagePath": "usageMetadata"
          }
        },
        {
          "match": {
            "path": "candidates",
            "op": "nonEmpty"
          },
          "response": {
            "textPath": "candidates[0].content.parts",
            "textFilter": [
              {
                "path": "thought",
                "op": "isFalse"
              },
              {
                "path": "functionCall",
                "op": "isNull"
              }
            ],
            "reasoningPath": "candidates[0].content.parts",
            "reasoningFilter": [
              {
                "path": "thought",
                "op": "isTrue"
              }
            ],
            "usagePath": "usageMetadata",
            "finishReasonPath": "candidates[0].finishReason"
          }
        }
      ],
      "doneValuesReplace": true
    }
  },
  "models": {
    "path": "/v1beta/models",
    "listPath": "models",
    "idPath": "name",
    "namePath": "displayName",
    "idStripPrefix": "models/"
  }
}
