{
  "host": "127.0.0.1",
  "port": 8765,
  "panelAccessToken": "change-me",
  "databasePath": "elysia-api.sqlite3",
  "logDatabasePath": "elysia-api-logs.sqlite3",
  "logLevel": "info",
  "logFormat": "auto",
  "logPersistLevel": "info",
  "httpTimeout": 120,
  "preparation": {
    "enabled": true,
    "maxConcurrent": 8,
    "maxQueued": 32,
    "maxReservedBodyBytes": 67108864,
    "queueTimeoutMillis": 5000
  },
  "secretKeyPath": ".master-key",
  "openBrowserOnStart": true,
  "agentRemote": {
    "enabled": true,
    "publicUrl": ""
  },
  "agent": {
    "toolLoopLimit": 30
  },
  "outbound": {
    "proxyUrl": "",
    "deniedIpRanges": [
      "0.0.0.0/8",
      "10.0.0.0/8",
      "100.64.0.0/10",
      "127.0.0.0/8",
      "169.254.0.0/16",
      "172.16.0.0/12",
      "192.0.2.0/24",
      "192.168.0.0/16",
      "198.18.0.0/15",
      "198.51.100.0/24",
      "203.0.113.0/24",
      "224.0.0.0/4",
      "240.0.0.0/4",
      "::1/128",
      "::/128",
      "fc00::/7",
      "fe80::/10",
      "ff00::/8"
    ]
  },
  "usageLog": {
    "persistEnabled": true,
    "retentionDays": 14,
    "maxContentMB": 1024,
    "maxRecords": 0,
    "bodyMaxKB": 0,
    "bodyOnErrorOnly": false,
    "externalizeMedia": true,
    "cleanupIntervalMinutes": 60
  },
  "systemLog": {
    "retentionDays": 30,
    "maxRecords": 0,
    "maxContentMB": 256
  },
  "modelCatalog": {
    "enabled": true,
    "url": "",
    "proxy": "",
    "syncIntervalMinutes": 1440
  }
}
