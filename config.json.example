{
  "host": "127.0.0.1",
  "port": 8765,
  "panelAccessToken": "change-me",
  "databasePath": "elysia-api.sqlite3",
  "logLevel": "info",
  "httpTimeout": 120,
  "secretKeyPath": ".master-key",
  "openBrowserOnStart": true,
  "agentRemote": {
    "enabled": true,
    "publicUrl": ""
  },
  "outbound": {
    "deniedIpRanges": [
      "0.0.0.0/8",
      "10.0.0.0/8",
      "100.64.0.0/10",
      "127.0.0.0/8",
      "169.254.0.0/16",
      "172.16.0.0/12",
      "192.0.2.0/24",
      "192.168.0.0/16",
      "198.18.0.0/15",
      "198.51.100.0/24",
      "203.0.113.0/24",
      "224.0.0.0/4",
      "240.0.0.0/4",
      "::1/128",
      "::/128",
      "fc00::/7",
      "fe80::/10",
      "ff00::/8"
    ]
  },
  "usageLog": {
    "persistEnabled": true,
    "retentionDays": 0,
    "maxStorageMB": 0,
    "maxRecords": 0,
    "bodyMaxKB": 1024,
    "bodyOnErrorOnly": false,
    "externalizeMedia": true,
    "cleanupIntervalMinutes": 60
  },
  "modelCatalog": {
    "enabled": true,
    "url": "",
    "proxy": "",
    "syncIntervalMinutes": 1440
  }
}
