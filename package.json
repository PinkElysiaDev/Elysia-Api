{
  "name": "elysia-api",
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-standalone.mjs",
    "build:macos-app": "node scripts/build-macos-app.mjs",
    "build:webui": "npm run build --workspace @root/webui",
    "lint": "npm exec eslint -- packages/webui --cache --ext=ts,tsx",
    "lint-fix": "npm exec eslint -- packages/webui --cache --ext=ts,tsx --fix"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "typescript": "^5.9.2"
  }
}
