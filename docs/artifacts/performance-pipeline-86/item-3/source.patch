 }
 
+func plainJSONString(value string) bool {
+	for index := range len(value) {
+		character := value[index]
+		if character < 0x20 || character >= 0x80 || character == '"' || character == '\\' || character == '<' || character == '>' || character == '&' {
+			return false
+		}
+	}
+	return true
+}
