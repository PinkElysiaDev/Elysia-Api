{
  "expressions": {
    "cache-usage": {
      "op": "if",
      "when": {
        "op": "all",
        "items": [
          {
            "op": "exists",
            "source": {
              "op": "read",
              "path": "/usage/provider_metrics/write_tokens",
              "from": "root"
            }
          },
          {
            "op": "not",
            "source": {
              "op": "exists",
              "source": {
                "op": "read",
                "path": "/cacheCreation",
                "from": "binding",
                "name": "decoded-usage"
              }
            }
          }
        ]
      },
      "then": {
        "op": "merge",
        "policy": "last",
        "items": [
          {
            "op": "read",
            "path": "",
            "from": "binding",
            "name": "decoded-usage"
          },
          {
            "op": "object",
            "fields": {
              "cacheCreation": {
                "op": "object",
                "fields": {
                  "count": {
                    "op": "read",
                    "path": "/usage/provider_metrics/write_tokens",
                    "from": "root"
                  },
                  "origin": {
                    "op": "literal",
                    "value": "observed"
                  }
                }
              }
            }
          }
        ]
      },
      "otherwise": {
        "op": "read",
        "path": "",
        "from": "binding",
        "name": "decoded-usage"
      }
    },
    "decode-usage": {
      "op": "let",
      "name": "decoded-usage",
      "source": {
        "op": "ref",
        "ref": "standard-decode-usage"
      },
      "body": {
        "op": "ref",
        "ref": "cache-usage"
      }
    },
    "stream-decode-usage": {
      "op": "let",
      "name": "decoded-usage",
      "source": {
        "op": "ref",
        "ref": "standard-stream-decode-usage"
      },
      "body": {
        "op": "ref",
        "ref": "cache-usage"
      }
    }
  }
}
